# ─── Trading Mode ────────────────────────────────────────────────────────────
DRY_RUN=true                          # Set false for live trading (danger!)
LOOP_INTERVAL_SECONDS=300             # How often the bot evaluates (seconds)
TRADE_AMOUNT_USDC=10.0                # USDC per trade in live mode
INITIAL_CAPITAL_USDC=100.0            # Starting paper-trading capital

# ─── Solana / Wallet ─────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Generate these by running: python generate_wallet.py
WALLET_PUBLIC_KEY=
WALLET_PRIVATE_KEY_ENCRYPTED=
WALLET_ENCRYPTION_KEY=

# ─── Telegram Alerts ─────────────────────────────────────────────────────────
# Create a bot via @BotFather and get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Dashboard ───────────────────────────────────────────────────────────────
DASHBOARD_PORT=8080

# ─── Risk Management ─────────────────────────────────────────────────────────
MAX_POSITION_SIZE_PCT=0.25            # Max 25% of portfolio per trade
MAX_DRAWDOWN_PCT=0.15                 # Stop trading at 15% portfolio drawdown
STOP_LOSS_PCT=0.05                    # Exit position at -5%
TAKE_PROFIT_PCT=0.12                  # Exit position at +12%

# ─── Signal Thresholds ───────────────────────────────────────────────────────
BUY_THRESHOLD=0.62                    # Composite score >= this → BUY
SELL_THRESHOLD=0.38                   # Composite score <= this → SELL

# ─── RSI ─────────────────────────────────────────────────────────────────────
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# ─── MACD ────────────────────────────────────────────────────────────────────
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL_PERIOD=9
